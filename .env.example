APP_NAME="Estação Commit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Compatibilidade com clientes PostgreSQL antigos sem SNI (comum no PHP para
# Windows). Use apenas o primeiro trecho do host da Neon, sem "-pooler".
# Exemplo: para ep-projeto-123-pooler.us-east-2.aws.neon.tech, use ep-projeto-123.
DB_ENDPOINT=
# DB_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# O cadastro não envia e-mail de verificação. Esta checagem confere por DNS se o
# domínio do e-mail existe e recebe mensagens (não confirma a caixa em si).
# EMAIL_DNS_CHECK=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
REVERB_APP_ID=gamehub
REVERB_APP_KEY=gamehub-key
REVERB_APP_SECRET=gamehub-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Endereço INTERNO para o Laravel publicar eventos no Reverb. A imagem Docker já
# define 127.0.0.1:8080/http; no Render não é preciso configurar. Localmente, se
# ficarem vazias, valem REVERB_HOST/PORT/SCHEME acima.
# REVERB_PUBLISH_HOST=127.0.0.1
# REVERB_PUBLISH_PORT=8080
# REVERB_PUBLISH_SCHEME=http

# Conexões WebSocket simultâneas aceitas pelo Reverb (padrão 25 = ~6 salas de 4).
# Não aumente sem medir a RAM (Render Free: 512 MB). Ao atingir o limite, novas
# conexões são recusadas e o front continua atualizando por polling.
# REVERB_APP_MAX_CONNECTIONS=25

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# On Render, override these VITE_* values for the public service hostname,
# port 443, and https. They are embedded into the frontend during the Docker build.
# Keep REVERB_APP_SECRET out of every VITE_* variable.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

PROFILE_ADMIN_EMAILS=

# Tempo real: reverb (padrao) ou cloudflare (ver worker/README.md). Segredos NUNCA em VITE_*.
REALTIME_DRIVER=reverb
# REALTIME_WORKER_URL=
# REALTIME_TOKEN_SECRET=
# REALTIME_NOTIFY_SECRET=
GAME_ENGINE=laravel
# REALTIME_CALLBACK_SECRET=

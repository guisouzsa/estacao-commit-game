{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "estacao-commit-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      { "name": "CHANNEL", "class_name": "ChannelHub" },
      { "name": "MATCH", "class_name": "MatchRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChannelHub"] },
    { "tag": "v2", "new_sqlite_classes": ["MatchRoom"] }
  ],
  "vars": {
    "APP_ORIGIN": "https://estacaocommit.onrender.com",
    "LARAVEL_CALLBACK_URL": "https://estacaocommit.onrender.com",
    "ALLOWED_ORIGINS": "https://estacaocommit.onrender.com,http://localhost:8000,http://127.0.0.1:8000"
  }
}
